<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ipp</name>
  <version>0.0.0</version>
  <description>Informative path planning package</description>

  <maintainer email="b.lato@web.de">Bennett Latosinszky</maintainer>

  <license>GPLv2</license>

  <author email="b.lato@web.de">Bennett Latosinszky</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>yaml-cpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>ipp_interfaces</depend>
  <depend>scalar_field_interfaces</depend>
  <exec_depend>hippo_common</exec_depend>
  <exec_depend>hippo_control_msgs</exec_depend>
  <exec_depend>hippo_sim</exec_depend>
  <exec_depend>tf_transformations</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
